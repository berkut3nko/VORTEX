# Writes the build identity header (BuildInfo.cmake runs it at configure time and on every build):
#   cmake -DENGINE_DIR=<engine> -DTOP_DIR=<top project> -DTOP_NAME=<name> -DOUT=<header>
#         -DBUILD_TYPE=<config> -DCOMPILER=<id version> -DCPU_FLAGS=<flags> -P GenerateBuildInfo.cmake
# The header changes only when its content does (a commit, a dirty flip, a branch), so only
# src/core/internal/Build.cpp recompiles then; no module interface sees it.
find_package(Git QUIET)

# _describe(DIR OUT_COMMIT OUT_BRANCH IGNORE_SUBMODULES): the 12-digit commit ("-dirty" with tracked
# changes, or untracked files that are not ignored in the source folders) and the branch of the
# checkout at DIR; "unknown" without git.
function(_describe dir out_commit out_branch ignore_submodules)
    set(_commit "unknown")
    set(_branch "unknown")
    if(GIT_EXECUTABLE AND EXISTS "${dir}")
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${dir}" rev-parse --short=12 HEAD
            OUTPUT_VARIABLE _c RESULT_VARIABLE _r OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(_r EQUAL 0 AND _c)
            set(_commit "${_c}")
            # --no-optional-locks: never take index.lock (another git command may run at the same time).
            execute_process(COMMAND "${GIT_EXECUTABLE}" --no-optional-locks -C "${dir}" status --porcelain --untracked-files=no
                "--ignore-submodules=${ignore_submodules}"
                OUTPUT_VARIABLE _s RESULT_VARIABLE _r2 OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
            # Untracked files count only in the source folders: CMake globs every .cpp / .cppm there
            # into the build, so a file left out of a commit is still in the binary.
            execute_process(COMMAND "${GIT_EXECUTABLE}" --no-optional-locks -C "${dir}" ls-files --others --exclude-standard
                -- src tests tools cmake shaders CMakeLists.txt
                OUTPUT_VARIABLE _u RESULT_VARIABLE _r4 OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
            if((_r2 EQUAL 0 AND _s) OR (_r4 EQUAL 0 AND _u))
                string(APPEND _commit "-dirty")
            endif()
            execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${dir}" rev-parse --abbrev-ref HEAD
                OUTPUT_VARIABLE _b RESULT_VARIABLE _r3 OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
            if(_r3 EQUAL 0 AND _b)
                set(_branch "${_b}")
            endif()
        endif()
    endif()
    set(${out_commit} "${_commit}" PARENT_SCOPE)
    set(${out_branch} "${_branch}" PARENT_SCOPE)
endfunction()

# The engine's own changes count; a game's "-dirty" means its tracked files changed or the engine
# submodule points elsewhere than the game's commit says (not the engine's uncommitted edits).
_describe("${ENGINE_DIR}" _engine_commit _engine_branch none)
set(_game_name "")
set(_game_commit "")
set(_game_branch "")
get_filename_component(_engine_real "${ENGINE_DIR}" REALPATH)
get_filename_component(_top_real "${TOP_DIR}" REALPATH)
if(NOT _engine_real STREQUAL _top_real)
    set(_game_name "${TOP_NAME}")
    _describe("${TOP_DIR}" _game_commit _game_branch dirty)
endif()

set(_content "// Generated by engine/cmake/GenerateBuildInfo.cmake: do not edit, do not include from a module interface.
#pragma once
#define VORTEX_BUILD_ENGINE_COMMIT \"${_engine_commit}\"
#define VORTEX_BUILD_ENGINE_BRANCH \"${_engine_branch}\"
#define VORTEX_BUILD_GAME_NAME \"${_game_name}\"
#define VORTEX_BUILD_GAME_COMMIT \"${_game_commit}\"
#define VORTEX_BUILD_GAME_BRANCH \"${_game_branch}\"
#define VORTEX_BUILD_TYPE \"${BUILD_TYPE}\"
#define VORTEX_BUILD_COMPILER \"${COMPILER}\"
#define VORTEX_BUILD_CPU_FLAGS \"${CPU_FLAGS}\"
")
file(WRITE "${OUT}.tmp" "${_content}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
